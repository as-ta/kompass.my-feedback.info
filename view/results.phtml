$resultsUrl = fn (string $action, array $params = []) => $this->escapeHtmlAttr($this->url('wizard', [], ['query' => ['account' => $action] + $params]));
$number = static fn (float|int $value, int $decimals = 1): string => str_replace('-', '−', number_format($value, $decimals, ',', '.'));
$chartJson = static fn (array $data): string => json_encode($data, JSON_THROW_ON_ERROR | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE);

// Anteil der Antworten in der oberen Hälfte einer Skala (z. B. CES 5–7 von 1–7)
$topShare = static function (array $question): ?float {
    if ($question['answered'] === 0 || $question['options'] === []) {
        return null;
    }
    $values = array_map(static fn (array $o): ?int => $o['numeric'] === null ? null : (int) $o['numeric'], $question['options']);
    if (in_array(null, $values, true)) {
        return null;
    }
    $middle = (min($values) + max($values)) / 2;
    $top = 0;
    foreach ($question['options'] as $option) {
        if ((int) $option['numeric'] > $middle) {
            $top += $option['count'];
        }
    }
    return 100 * $top / $question['answered'];
};
$npsVerdict = static fn (float $nps): string => match (true) {
    $nps < 0 => 'Mehr Kritiker als Befürworter. Hier lohnt es sich anzusetzen.',
    $nps < 30 => 'Solide: Es gibt mehr Befürworter als Kritiker.',
    $nps < 70 => 'Sehr gut: Viele empfehlen Sie aktiv weiter.',
    default => 'Hervorragend: Ihre Kunden sind echte Fans.',
};
