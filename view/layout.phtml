<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $this->pageTitle ? $this->escapeHtml($this->pageTitle) . ' · ' : '' ?>myFeedback Kompass</title>
    <link rel="icon" type="image/svg+xml" href="<?= $this->escapeHtmlAttr($this->basePath('/icon-kompass.svg')) ?>">
    <link rel="stylesheet" href="<?= $this->escapeHtmlAttr($this->basePath('/wizard.css') . '?v=' . filemtime(dirname(__DIR__) . '/public/wizard.css')) ?>">
    <script src="<?= $this->escapeHtmlAttr($this->basePath('/wizard.js') . '?v=' . filemtime(dirname(__DIR__) . '/public/wizard.js')) ?>" defer></script>
</head>
<body>
    <header class="site-header">
        <div class="shell brand">
            <a href="<?= $this->escapeHtmlAttr($this->url('wizard')) ?>" aria-label="myFeedback Kompass · Zur Startseite">
                <img src="<?= $this->escapeHtmlAttr($this->basePath('/logo-kompass.svg')) ?>" alt="myFeedback Kompass" width="390" height="75">
            </a>
            <p class="brand-claim">Sie kennen Ihr Anliegen. Wir kennen die Fragen.</p>
            <nav class="account-nav" aria-label="Seitennavigation">
                <a class="account-nav-faq<?= $this->accountUser ? ' account-nav-faq--menu' : '' ?>" href="<?= $this->escapeHtmlAttr($this->url('wizard', [], ['query' => ['faq' => '1']])) ?>"<?= $this->accountCurrent === 'faq' ? ' aria-current="page"' : '' ?>>FAQ</a>
                <?php if ($this->accountUser): ?>
                    <?= $this->partial('wizard/account-menu', ['current' => $this->accountCurrent ?? '', 'csrf' => $this->accountUser['csrf'], 'admin' => $this->accountUser['admin']]) ?>
                <?php elseif ($this->accountEnabled): ?>
                    <a class="account-login" href="<?= $this->escapeHtmlAttr($this->url('wizard', [], ['query' => ['account' => 'login']])) ?>">Anmelden</a>
                <?php endif ?>
            </nav>
        </div>
    </header>
    <?php
        $locations = ['list' => 'Meine Befragungen', 'new' => 'Neue Befragung', 'results' => 'Ergebnisse', 'branding' => 'Erscheinungsbild',
            'invoices' => 'Meine Rechnungen', 'billing' => 'Rechnungsdaten', 'faq' => 'FAQ', 'contact' => 'Kontakt',
            'bookkeeping' => 'Buchhaltung', 'issuer' => 'Rechnungsaussteller'];
        $location = $this->accountUser ? ($locations[$this->accountCurrent ?? ''] ?? null) : null;
    ?>
    <?php if ($location !== null): ?>
        <p class="mobile-location"><span class="shell">Mein Konto <span aria-hidden="true">›</span> <strong><?= $this->escapeHtml($location) ?></strong></span></p>
    <?php endif ?>
    <main class="shell main<?= ($this->accountWorkspace || $this->wizardWorkspace) ? ' account-shell' : '' ?>">
        <?php if ($this->editing && $this->wizardWorkspace): ?>
            <p class="editing-banner" role="status">
                Sie passen „<?= $this->escapeHtml($this->editing['title']) ?>“ an. Die Änderungen werden erst mit „Änderungen übernehmen“ gespeichert.
                <a href="<?= $this->escapeHtmlAttr($this->url('wizard', [], ['query' => ['account' => 'edit-cancel']])) ?>">Abbrechen</a>
            </p>
        <?php endif ?>
        <?php if ($this->progress): ?>
            <?= $this->partial('wizard/progress', ['progress' => $this->progress]) ?>
        <?php endif ?>
        <?php if ($this->wizardWorkspace): ?>
            <div class="account-workspace">
                <?= $this->partial('wizard/workspace-nav', ['current' => $this->editing ? 'list' : 'new', 'csrf' => $this->workspaceCsrf]) ?>
                <div class="wizard-workspace-content"><?= $this->content ?></div>
            </div>
        <?php else: ?>
            <?= $this->content ?>
        <?php endif ?>
    </main>
</body>
</html>
