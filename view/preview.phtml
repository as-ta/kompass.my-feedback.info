            <?php foreach ($questions as $question): ?>
                <li><?= $this->escapeHtml($question['text']) ?></li>
            <?php endforeach ?>
            <?php if ($commentText !== null): ?>
                <li><?= $this->escapeHtml($commentText) ?> <span class="detail">Freiwillige Antwort in eigenen Worten</span></li>
            <?php endif ?>
