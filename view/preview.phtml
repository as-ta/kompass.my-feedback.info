            <form method="post" action="<?= $this->escapeHtmlAttr($this->url('wizard', [], ['query' => ['account' => 'save']])) ?>">
                <input type="hidden" name="draft" value="<?= $this->escapeHtmlAttr($draftKey) ?>">
                <input type="hidden" name="csrf" value="<?= $this->escapeHtmlAttr($draftCsrf) ?>">
                <button type="submit" aria-describedby="draft-action-hint"><?= $loggedIn ? 'Weiter zur Freischaltung' : 'Weiter zur Anmeldung' ?> <span aria-hidden="true">→</span></button>
            </form>
            <p id="draft-action-hint">
                Wir speichern die Empfehlung kostenlos und unverbindlich in Ihrem Konto.
                <?php if ($formattedPrice !== null): ?>
                    Freischalten können Sie später: <strong>4 Wochen für <?= $this->escapeHtml($formattedPrice) ?></strong> inkl. MwSt., einmalig per PayPal oder Karte, kein Abo nötig. Den Start bestimmen Sie selbst.
                <?php else: ?>
                    Ob und wann Sie die Befragung freischalten, entscheiden Sie danach.
                <?php endif ?>
            </p>
        </div>
