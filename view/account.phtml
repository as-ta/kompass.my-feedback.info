        <a href="<?= $this->escapeHtmlAttr($this->url('wizard', [], $accountUrl('invoices'))) ?>">Zu meinen Rechnungen</a>
    <?php elseif ($page === 'missing'): ?>
        <h1>Entwurf nicht verfügbar</h1>
        <a href="<?= $this->escapeHtmlAttr($this->url('wizard', [], $accountUrl('list'))) ?>">Zu meinen Befragungen</a>
    <?php else: ?>
        <h1><?= $page === 'unavailable' ? 'Das Konto ist gerade nicht verfügbar' : 'Bitte laden Sie die Seite neu' ?></h1>
        <a href="<?= $this->escapeHtmlAttr($this->url('wizard')) ?>">Zurück zum Kompass</a>
    <?php endif ?>
</section>
<?php if ($workspace): ?>
</div>
<?php endif ?>
