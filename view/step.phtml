<?php
$isGoal = $stepId === 'goal';
$isCheckboxStep = isset($step['checkboxes']);
$choices = $step['checkboxes'] ?? $step['options'];
$checked = is_string($selected)
    ? ($step['options'][$selected]['selection'] ?? explode('-', $selected))
    : (array) $selected;
$url = $this->url('wizard');
$backUrl = $this->url('wizard', [], ['query' => $back]);
?>
<section class="card card--progress" style="--fill: <?= round($progress * 100) ?>%" aria-labelledby="question">
    <p class="eyebrow">Anliegen klären</p>
    <h1 id="question"><?= $this->escapeHtml($step['title']) ?></h1>
    <p class="intro" id="hint"><?= $this->escapeHtml($step['hint']) ?></p>

    <?php if ($invalid): ?>
        <p class="error" role="alert">
            <?php if ($isCheckboxStep): ?>
                Bitte wählen Sie mindestens <?= $stepId === 'metric' ? 'eine Frage' : 'ein Thema' ?>.
            <?php else: ?>
                Bitte wählen Sie eine der angezeigten Antworten.
            <?php endif ?>
        </p>
    <?php endif ?>

    <form method="get" action="<?= $this->escapeHtmlAttr($url) ?>"<?= $isCheckboxStep ? '' : ' data-step-form' ?>>
        <?= $this->partial('wizard/fields', ['answers' => $answers]) ?>
        <?php if ($isCheckboxStep): ?>
            <input type="hidden" name="<?= $this->escapeHtmlAttr('choose-' . $stepId) ?>" value="1">
        <?php endif ?>

        <fieldset class="options<?= $stepId === 'branche' ? ' options--grid' : '' ?>" aria-labelledby="question" aria-describedby="hint">
            <?php foreach ($choices as $value => $option): ?>
                <label class="option">
                    <?php if ($isCheckboxStep): ?>
                        <input type="checkbox" name="<?= $this->escapeHtmlAttr($stepId) ?>[]" value="<?= $this->escapeHtmlAttr($value) ?>"<?= in_array($value, $checked, true) ? ' checked' : '' ?>>
                    <?php else: ?>
                        <input type="radio" name="<?= $this->escapeHtmlAttr($stepId) ?>"
                               value="<?= $this->escapeHtmlAttr($value) ?>"<?= $selected === $value ? ' checked' : '' ?> required>
                    <?php endif ?>
                    <span>
                        <strong><?= $this->escapeHtml($option['label']) ?></strong>
                        <?php if (isset($option['hint'])): ?>
                            <span class="detail"><?= $this->escapeHtml($option['hint']) ?></span>
                        <?php endif ?>
                    </span>
                </label>
            <?php endforeach ?>
        </fieldset>

        <div class="actions">
            <?php if ($answers !== []): ?>
                <a href="<?= $this->escapeHtmlAttr($backUrl) ?>">Zurück</a>
            <?php endif ?>
            <button type="submit">Weiter <span aria-hidden="true">→</span></button>
        </div>
    </form>
    <?= $this->partial('wizard/contact-link', ['compact' => !$isGoal]) ?>
</section>
