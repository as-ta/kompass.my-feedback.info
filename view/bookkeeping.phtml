<?php $bookUrl = fn (string $action, array $params = []) => $this->escapeHtmlAttr($this->url('wizard', [], ['query' => ['account' => $action] + $params])); ?>
<div class="account-workspace">
    <?= $this->partial('wizard/workspace-nav', ['current' => 'bookkeeping', 'csrf' => $csrf, 'bookkeepingAdmin' => true]) ?>
    <section class="card workspace-content">
        <div class="workspace-heading">
            <div>
                <p class="eyebrow">Administration</p>
                <h1>Buchhaltung</h1>
                <p class="intro">Alle bestätigten Zahlungen und zugehörigen Rechnungen.</p>
            </div>
            <?php if ($entries !== []): ?>
                <a class="workspace-create" href="<?= $bookUrl('bookkeeping-export') ?>">CSV herunterladen</a>
            <?php endif ?>
        </div>
