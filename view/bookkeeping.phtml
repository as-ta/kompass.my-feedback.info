            <p class="workspace-empty">Bisher liegen keine bestätigten Zahlungen vor.</p>
        <?php else: ?>
            <div class="bookkeeping-table" role="region" aria-label="Rechnungen und Zahlungen" tabindex="0">
                <table>
                    <thead><tr>
                        <th scope="col">Rechnung</th>
                        <th scope="col">Rechnungsdatum</th>
                        <th scope="col">Buchungsdatum</th>
                        <th scope="col">Kunde</th>
                        <th scope="col">Befragung / Buchung</th>
                        <th scope="col">Brutto</th>
                        <th scope="col">PayPal-Transaktion</th>
                        <th scope="col">Beleg</th>
                    </tr></thead>
                    <tbody>
                        <?php foreach ($entries as $entry): ?>
                            <tr>
                                <td>
                                    <?= $entry['invoice_number'] === null ? 'Rechnung fehlt' : $this->escapeHtml($entry['invoice_number']) ?>
                                    <?php if (($entry['invoice_problem'] ?? '') !== ''): ?>
                                        <p class="detail"><?= $this->escapeHtml($entry['invoice_problem']) ?></p>
                                    <?php endif ?>
                                </td>
                                <td><?= $this->escapeHtml($entry['invoice_date']) ?></td>
                                <td><?= $this->escapeHtml($entry['booking_date']) ?></td>
                                <td><?= $this->escapeHtml($entry['customer']) ?></td>
                                <td>Nr. <?= (int) $entry['poll_id'] ?> / <?= (int) $entry['period_number'] ?></td>
                                <td class="bookkeeping-amount"><?= $this->escapeHtml(str_replace('.', ',', $entry['gross'])) ?> €</td>
                                <td><?= $this->escapeHtml($entry['capture_id'] ?? '') ?></td>
                                <td>
                                    <?php if ($entry['invoice_number'] !== null): ?>
                                        <a href="<?= $bookUrl('bookkeeping-receipt', ['period' => $entry['period_id']]) ?>">ZUGFeRD-PDF</a>
                                    <?php endif ?>
                                </td>
                            </tr>
                        <?php endforeach ?>
                    </tbody>
                </table>
            </div>
        <?php endif ?>
    </section>
</div>
